es to inform first responders.\n- If you use assistive technologies, plan how you will leave with the devices.\n- Inform your support network where you keep your emergency supplies.","source":"hail","sectionPath":"Before (Prepare) > For Adults","sourceType":"core","embeddingModelVersion":"all-MiniLM-L6-v2-r5","embedding":[-0.033603,0.041737,0.09075,0.061762,0.016612,-0.00547,0.001098,0.064734,-0.085097,-0.065309,-0.061082,-0.063023,0.001899,0.031948,-0.02493,0.024882,0.016443,-0.017388,-0.021092,-0.013977,-0.014518,0.107943,-0.061797,0.0141,-0.034767,0.123609,-0.056225,0.028883,0.045608,0.002851,0.038329,-0.055928,-0.049396,-0.034682,-0.017744,0.050631,0.080737,-0.012837,0.000391,0.018826,-0.029649,-0.046694,0.016262,-0.104562,0.024515,0.005844,0.018393,-0.004043,0.082812,-0.034095,0.035027,-0.011179,0.038008,-0.009026,-0.021524,-0.018858,-0.010366,-0.038427,0.047717,-0.023142,-0.069958,0.024805,-0.04053,0.025667,-0.023886,0.048413,-0.043119,0.053974,0.102617,0.034802,0.059059,0.065575,-0.017778,0.026445,0.002852,-0.015884,-0.007641,-0.03897,0.075959,0.015034,-0.035313,0.061833,-0.022726,0.045375,0.017739,0.059936,0.048631,0.099665,-0.047065,0.062109,0.015827,-0.061049,0.002011,0.029668,0.002058,0.072811,0.034002,-0.137885,-0.016831,0.064154,-0.023898,-0.100322,0.022832,0.062056,0.041456,-0.018059,-0.002947,-0.055329,-0.043007,-0.034186,0.01856,-0.03135,-0.000382,0.001509,-0.00129,0.012088,-0.083633,-0.010138,-0.012539,-0.003069,-0.008606,-0.038027,0.087263,-0.021316,0.113085,0.019735,0.015952,-0.0,0.118445,0.028771,-0.020227,0.070237,0.084521,-0.058865,-0.01422,-0.002366,0.017148,0.045589,0.055336,0.040697,0.025866,-0.075647,-0.019592,-0.076494,0.016294,-0.02525,-0.111575,0.04025,-0.05033,-0.120991,-0.045077,0.065429,0.004431,0.043397,0.065827,0.033164,0.057361,0.031391,-0.015699,0.057804,0.014282,-0.02963,0.021469,0.044599,-0.068541,-0.007881,0.010068,-0.071702,0.019011,0.006455,-0.082392,-0.051543,0.085062,0.033904,0.100062,-0.089457,-0.057734,-0.066744,0.014062,