# LLM config for generate_dataset.py — copy to .env and fill in your token.
# Works with Anthropic directly or any Anthropic-compatible endpoint.

# API key. Falls back to ANTHROPIC_API_KEY if unset.
LLM_API_TOKEN=

# Custom Anthropic-compatible base URL. Leave blank for Anthropic.
# For z.ai GLM:
# LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_BASE_URL=

# Model id. Default: claude-sonnet-4-20250514
# For z.ai GLM, e.g.:
# LLM_MODEL=glm-4.6
LLM_MODEL=

# Request timeout in milliseconds. Default: 3000000 (3000s)
LLM_TIMEOUT_MS=3000000
